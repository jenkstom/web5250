# ─────────────────────────────────────────────────────────────────────────────
# web5250 configuration — copy to .env and adjust.
#   cp .env.example .env && $EDITOR .env
# docker compose reads .env automatically from the same directory.
# Every variable is optional; defaults shown below.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM i target ────────────────────────────────────────────────────────────
# Hostname or IP of the IBM i, reachable from the container network.
IBM_I_HOST=as400.corp.lan

# TN5250 port: 23 = plain telnet, 992 = TLS.
IBM_I_PORT=23

# Use TLS for the host connection (true/false). Pair with port 992.
IBM_I_SSL=false

# EBCDIC code page matching the host CCSID:
#   cp037 US/Canada · cp273 German · cp277 Danish/Norwegian · cp278 Finnish/Swedish
#   cp280 Italian · cp284 Spanish · cp285 UK · cp297 French · cp500 International
#   cp871 Icelandic · cp1047 Latin-1 open systems · cp1140 = cp037 with Euro
IBM_I_CODEPAGE=cp037

# Terminal model advertised to the host. IBM-3477-FC = color, 27×132 capable;
# IBM-3179-2 = color, 24×80 only.
IBM_I_TERM_TYPE=IBM-3477-FC

# Prefix for auto-generated device names (each browser session gets its own
# device; total name is truncated to 10 chars). Example: PANG_ → PANG_A1B2C3.
IBM_I_DEV_PREFIX=PANG_

# Enforce CA validation for IBM_I_SSL=true. IBM i certificates are usually
# self-signed; leave false unless you mount a CA into the container.
IBM_I_TLS_REJECT_UNAUTHORIZED=false

# ── SOCKS5 egress proxy (first-boot seed system) ────────────────────────────
# Route the host connection through a SOCKS5 proxy (per-system afterwards in
# the admin editor). Set HOST to enable; USER/PASSWORD for proxies that
# require authentication. Leave all four empty for a direct connection.
IBM_I_PROXY_HOST=
IBM_I_PROXY_PORT=1080
IBM_I_PROXY_USER=
IBM_I_PROXY_PASSWORD=

# ── Gateway behaviour ────────────────────────────────────────────────────────
# Allow users to override host/port/ssl/term/codepage/devname via URL query
# parameters (?host=...&port=...). Keep false unless you trust every user
# behind the proxy.
ALLOW_CUSTOM_HOST=false

# Let host STRPCCMD commands that carry an http(s) URI (e.g. a program runs
# STRPCCMD PCCMD('start https://report.example/now')) open it in the user's
# browser. The URI never appears on the 5250 screen; the browser's own
# popup warning decides whether the window opens. Commands without a URI
# are always ignored. Set false to suppress host-pushed windows entirely.
ALLOW_HOST_URL_OPEN=true

# PIN for the admin editor of the connection menu (change me!). Users who
# enter it can add/edit/remove the systems offered on the menu. Leave empty
# to disable administration entirely.
ADMIN_PIN=

# Show the "Diag" button in the top bar. It copies raw 5250 stream
# diagnostics for the current session to the clipboard (bug reports);
# leave off unless you actually need to collect one.
SHOW_DIAG_BUTTON=false

# Location of the SQLite file backing the connection menu. In the container
# this points at the persistent volume; for local dev the default is
# ./data/web5250.db.
#WEB5250_DB=/data/web5250.db

# Published web port on the Docker HOST (the app always listens on 8080
# inside the container; compose maps this port -> 8080).
PORT=8080

# Set 1 to dump raw TN5250 hex traffic to the container log (debugging).
WEB5250_TRACE=

# ── Session lifetime ────────────────────────────────────────────────────────
# How fast a vanished browser frees its iSeries connection. The gateway pings
# each browser every WS_PING_INTERVAL_MS and drops the browser socket after
# WS_PING_MAX_MISSES consecutive missed pongs. Grace window ≈ interval ×
# misses; keep it large enough that a throttled browser (hidden tab, battery
# saver) or a proxy that mishandles WS control frames never kills a live
# session.
WS_PING_INTERVAL_MS=30000
WS_PING_MAX_MISSES=4

# How long a session with no attached browser stays alive and re-attachable
# (ms). This is what makes reloads, closed tabs, split-view pop-outs and
# dropped connections survivable: the host session (and its device name)
# waits in the gateway for a browser to come back via ?attach=<token>.
# 0 restores strict legacy behaviour (socket closed = session ended).
SESSION_GRACE_MS=300000

# ── Image source ─────────────────────────────────────────────────────────────
# docker-compose.yml builds the image locally. docker-compose.registry.yml
# instead pulls the published image (its default) — override IMAGE here only
# to use another registry or tag:
#   IMAGE=ghcr.io/jenkstom/web5250:v1.0.0
IMAGE=
